# Threat Intel Toolkit - IBM Bob installer settings.
# Copy to ".env" (cp .env.example .env). ".env" is git-ignored. No secrets are needed.
# Real environment variables override values in this file.

# Which repository to install from: fork | upstream | custom
TI_SOURCE=fork

# Repository URLs (HTTPS only, no credentials inside the URL)
TI_FORK_URL=https://github.com/ncee-dp-tech-sme/threat-intel-toolkit.git
TI_UPSTREAM_URL=https://github.com/kevinmhorvath/threat-intel-toolkit.git
# Used only when TI_SOURCE=custom (set automatically by: install-bob.sh switch <https-url>)
TI_CUSTOM_URL=

# Branch or tag to install
TI_REF=main

# Install scope: global (~/.bob, all projects) | project (<TI_PROJECT_DIR>/.bob)
TI_SCOPE=global
# Only used when TI_SCOPE=project (absolute path to your project folder)
TI_PROJECT_DIR=

# Download the threat-feed cache right after installing (true/false)
TI_BUILD_CACHE=true

# Location of Bob's config folder (default: ~/.bob)
BOB_HOME=

# Installer log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Testing only: allow a local folder path instead of an https URL (true/false)
TI_ALLOW_LOCAL_SOURCE=false
